rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // User vault data: only accessible by the authenticated user themselves
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Split Bill Groups: accessible by members in memberUids array
    match /groups/{gid} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberUids;
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.memberUids;

      match /{sub=**} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(db)/documents/groups/$(gid)).data.memberUids;
      }
    }
  }
}
